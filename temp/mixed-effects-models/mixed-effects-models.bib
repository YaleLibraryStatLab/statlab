  issn         = {0022-3476,1097-6833},
  abstract     = {The statistical methods most familiar to readers of the
                  biomedical or social-behavioral literature usually assume
                  independence of sampling. The Student t test, 1-way ANOVA,
                  their nonparametric equivalents, as well as the χ2 and basic
